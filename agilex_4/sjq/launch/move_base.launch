<launch>
  <!-- Run move base -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base"  output="screen">
    <rosparam file="$(find sjq)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find sjq)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find sjq)/param/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find sjq)/param/global_costmap_params.yaml" command="load" />

    <!-- <rosparam file="$(find sjq)/param/base_local_planner_params.yaml" command="load" /> -->
    <!-- <rosparam file="$(find sjq)/param/move_base_params.yaml" command="load" /> -->
    
    <param name="base_global_planner" value="global_planner/GlobalPlanner" /> 

    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <rosparam file="$(find sjq)/param/teb_local_planner_params.yaml" command="load" />

    <!-- <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS" /> -->

    <param name="GlobalPlanner/use_dijkstra" value="true"/>
    <param name= "controller_frequency" value="10" type="double"/>
  </node>


</launch>
