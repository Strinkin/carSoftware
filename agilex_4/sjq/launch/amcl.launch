<launch>
    <!-- 启动雷达 -->
    <include file="$(find scout_bringup)/launch/open_rslidar.launch" />

    <!-- 设置地图的配置文件 -->
    <arg name="map" default="map305.yaml" />

    <!-- 运行地图服务器，并且加载设置的地图-->
    <node name="map_server" pkg="map_server" type="map_server" args="$(find sjq)/maps/$(arg map)"/>

    <!-- 启动AMCL节点 -->
    <!-- <include file="$(find sjq)/launch/amcl_omni.launch" /> -->
    <node pkg="jie_ware" type="lidar_loc" name="lidar_loc" >
        <param name="base_frame" value="base_footprint" />
        <param name="odom_frame" value="odom" />
        <param name="laser_frame" value="laser" />
        <param name="laser_topic" value="scan" />
    </node>
    <node pkg="jie_ware" type="costmap_cleaner" name="costmap_cleaner" />
    <!-- 运行rviz -->
    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find sjq)/rviz/amcl.rviz" output="screen"/> -->
</launch>
